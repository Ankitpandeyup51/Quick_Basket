
@{
    ViewBag.Title = "AddCategory";
    Layout = "~/Views/Shared/_AdminLayoutPage1.cshtml";
}

<div class="container-fluid">
    <div class="row py-3">
        <div class="col-sm-10 mx-auto">
            <div class="fs-3 text-center">
                Basket <b class="text-color1">Category</b><br />
                <hr class="mx-auto w-25" />
            </div>
            <div class="row py-3">
                <div class="col-sm-6 px-5">
                    @if (TempData["msg"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>@TempData["msg"]</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <form method="post" enctype="multipart/form-data">
                        <div class="shadow-lg mx-auto p-3 rounded-3">
                            <div class="mb-2"> <span style="font-size:13px;"> Fil the details below create or update a category</span></div>
                            <span><b>Category Name</b></span>
                            <input type="text" class="form-control mb-3"
                                   name="cname" required placeholder="Enter Catergory Name" />
                            <span><b>Category Picture*</b></span>
                            <input type="file" class="form-control mb-3"
                                   name="cpic" required placeholder="Enter catergory name" />
                            <button class="btn bg-color2" type="submit">Add Now</button>
                        </div>
                    </form>
                </div>
                <div class="col-sm-6">
                    <div class="shadow-lg mx-auto p-3">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>SR No.</th>
                                    <th> Name</th>
                                    <th> Picture</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                @if(ViewBag.dt!=null)
                {
                    foreach(var row in ViewBag.dt.Rows)
                {

                                <tr>
                                    <td>@row["id"]</td>
                                    <td>@row["name"]</td>
                                    <td><img src="~/Content/catpic/@row["icon"]" height="50px" width="50px" /></td>

                                    <td>
                                        <a class="badge bg-color1 text-dark">
                                            <i class="fa-solid fa-pencil"></i>
                                        </a>
                                        <a class="badge bg-color1 text-dark">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>

                    }
                } 
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

