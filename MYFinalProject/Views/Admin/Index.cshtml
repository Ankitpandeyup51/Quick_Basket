
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayoutPage1.cshtml";
}
<style>
    .dashboard-card {
        background: #fff;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
        transition: .35s;
        height: 100%;
        border: 1px solid #f2f2f2;
    }

        .dashboard-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 35px rgba(0,0,0,.15);
        }

    .card-title {
        color: #6c757d;
        font-size: 15px;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .dashboard-card h2 {
        font-size: 34px;
        font-weight: 700;
        color: #222;
        margin-bottom: 15px;
    }

    .icon-box {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #fff;
        font-size: 28px;
        box-shadow: 0 8px 18px rgba(0,0,0,.15);
    }

    .view-btn {
        display: inline-block;
        text-decoration: none;
        color: #ff6b00;
        font-weight: 600;
        font-size: 14px;
        transition: .3s;
    }

        .view-btn:hover {
            color: #e65c00;
            letter-spacing: .5px;
        }

    .bg-primary {
        background: linear-gradient(135deg,#4f46e5,#6366f1) !important;
    }

    .bg-success {
        background: linear-gradient(135deg,#10b981,#34d399) !important;
    }

    .bg-warning {
        background: linear-gradient(135deg,#f59e0b,#fbbf24) !important;
    }

    .bg-danger {
        background: linear-gradient(135deg,#ef4444,#f87171) !important;
    }
</style>
<div class="container-fluid">
    <div class="row py-2">
        <div class="col-sm-10 mx-auto">
            <div class="fs-5">
                Welcome back <b class="text-color1">Chhavi !</b><br />
            </div>
            <span style="font-size:13px;">  Heres's what's happing with the account today.</span>
            <div class="row g-4 py-3">

                <!-- Total Orders -->
                <div class="col-lg-3 col-md-6">
                    <div class="dashboard-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="card-title">Total Orders</p>
                                <h2>@ViewBag.dt.Rows[0][0]</h2>

                                <a href="/Admin/ManageOrders" class="view-btn">
                                    View Details
                                    <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>

                            <div class="icon-box bg-primary">
                                <i class="fa-solid fa-shopping-bag"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delivered Orders -->
                <div class="col-lg-3 col-md-6">
                    <div class="dashboard-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="card-title">Delivered Orders</p>
                                <h2>@ViewBag.dn.Rows[0][0]</h2>

                                <a href="/Admin/AllOrders" class="view-btn">
                                    View Details
                                    <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>

                            <div class="icon-box bg-success">
                                <i class="fa-solid fa-box"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Categories -->
                <div class="col-lg-3 col-md-6">
                    <div class="dashboard-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="card-title">Categories</p>
                                <h2>@ViewBag.tc.Rows[0][0]</h2>

                                <a href="/Admin/AddCategory" class="view-btn">
                                    View Details
                                    <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>

                            <div class="icon-box bg-warning">
                                <i class="fa-solid fa-tags"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Products -->
                <div class="col-lg-3 col-md-6">
                    <div class="dashboard-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="card-title">Products</p>
                                <h2>@ViewBag.p.Rows[0][0]</h2>

                                <a href="/Admin/addProduct" class="view-btn">
                                    View Details
                                    <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>

                            <div class="icon-box bg-danger">
                                <i class="fa-solid fa-cart-shopping"></i>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="row g-4 py-3">

                <!-- Recent Orders -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-lg rounded-4 h-100">
                        <div class="card-header bg-dark text-white rounded-top-4 py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-shopping-bag me-2"></i>Recent Orders
                            </h5>
                        </div>

                        <div class="card-body p-0">

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">

                                    <thead class="table-light">
                                        <tr>
                                            <th>#Order</th>
                                            <th>Date</th>
                                            <th>Email</th>
                                            <th>Price</th>
                                            <th>Qty</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var row in ViewBag.ro.Rows)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="badge bg-primary px-3 py-2">
                                                        @row["orderid"]
                                                    </span>
                                                </td>

                                                <td>
                                                    @Convert.ToDateTime(row["added_on"]).ToString("dd MMM yyyy")
                                                </td>

                                                <td>@row["email"]</td>

                                                <td class="fw-bold text-success">
                                                    ₹@row["totalprice"]
                                                </td>

                                                <td>
                                                    <span class="badge bg-warning text-dark">
                                                        @row["qty"]
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>

                                </table>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Recent Customers -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-lg rounded-4 h-100">

                        <div class="card-header bg-dark text-white rounded-top-4 py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-users me-2"></i>Recent Customers
                            </h5>
                        </div>

                        <div class="card-body p-0">

                            <div class="table-responsive">

                                <table class="table table-hover align-middle mb-0">

                                    <thead class="table-light">
                                        <tr>
                                            <th>Email</th>
                                            <th>Date</th>
                                            <th>Name</th>
                                            <th>Gender</th>
                                            <th>Mobile</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var item in ViewBag.rc.Rows)
                                        {
                                            <tr>

                                                <td>@item["email"]</td>

                                                <td>
                                                    @Convert.ToDateTime(item["added_on"]).ToString("dd MMM yyyy")
                                                </td>

                                                <td class="fw-semibold">
                                                    @item["name"]
                                                </td>

                                                <td>
                                                    @if (item["gender"].ToString() == "Male")
                                                    {
                                                        <span class="badge bg-primary">Male</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Female</span>
                                                    }
                                                </td>

                                                <td>@item["mobile"]</td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>
                </div>

            </div>        </div>
    </div>
</div>

