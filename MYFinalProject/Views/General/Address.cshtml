
@{
    ViewBag.Title = "Address";
    Layout = "~/Views/Shared/_GeneralLayoutPage1.cshtml";
}


<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 mx-auto p-4">
            <h2 class="fw-bold">
                Saved <span class="text-color1">Address</span>
            </h2>
            <p> Manage and make change to your saved address</p>
            <hr class="w-50" />
            <button class="btn bg-color1  text-light "data-bs-toggle="modal" data-bs-target="#exampleModal">+ Add new address</button>
            <div class="row">
                @*Address box*@
                @foreach (var add in ViewBag.add.Rows)
                {
                <div class="col-sm-6 mb-2 p-3 mt-3 shadow" style="border:1px solid #F97316;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-danger text-light d-flex justify-content-center align-items-center"
                             style="width:60px; height:60px; min-width:60px;">
                            <i class="fa fa-home fs-4"></i>
                        </div>
                        <div>
                            <span class="text-dark fw-bold fs-5">@add["addresstype"]</span><br /><br />
                            <span class="text-dark fs-6">@add["email"]</span><br />
                            <span class="text-secondary small">@add["fulladdress"],@add["city"],@add["landmark"],@add["pincode"],@add["state"]</span><br />
                            <span class="text-secondary small">phone:@add["mobile"]</span>
                        </div>
                    </div>
                    <hr class="w-100" />
                    <div class="text-center">
                        <a href="/general/deleteaddress/@add["id"]" class="text-color1" style="text-decoration:none;">
                            <i class="fa fa-trash"></i>&nbsp;delete
                        </a>
                    </div>
                </div>
                }
            </div>
                @*Address box*@
            </div>
        </div>
    </div>
</div>



@*full address  city pincode state landmark addresstype*@
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">New message</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <div class="modal-body">

                    <div class="mb-3">
                        <label for="Full Address" class="col-form-label">Full Address:</label>
                        <input type="text" class="form-control" id="FullAddress" name="Address">
                    </div>
                    <div class="mb-3">
                        <label for="City" class="col-form-label">City:</label>
                        <input type="text" class="form-control" id="city" name="City">
                    </div>
                    <div class="mb-3">
                        <label for="Pincode" class="col-form-label">PinCode:</label>
                        <input type="text" class="form-control" id="Pincode" name="Pincode">
                    </div>
                    <div class="mb-3">
                        <label for="state" class="col-form-label">State:</label>
                        <input type="text" class="form-control" id="state" name="State">
                    </div>
                    <div class="mb-3">
                        <label for="landmark" class="col-form-label">Landmark:</label>
                        <input type="text" class="form-control" id="landmark" name="Landmark">
                    </div>
                    <div class="mb-3">
                        <label for="addresstype" class="col-form-label">AddressStype:</label>
                        <input type="text" class="form-control" id="addresstype" name="Addresstype">
                    </div>
                    <div class="mb-3">
                        <label for="mobile" class="col-form-label">Mobile number:</label>
                        <input type="number" class="form-control" id="Mobile" name="Mobile">
                    </div>

                </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Address</button>
            </div>
            </form>
        </div>
    </div>
</div>
