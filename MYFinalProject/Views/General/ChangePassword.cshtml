
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_GeneralLayoutPage1.cshtml";
}

@*Heading Start*@
<div class-="row">
    <div class="col-sm-10 mx-auto py-2 text-center">
        <i class="fa-solid fa-lock  bg-light text-color1 rounded-circle p-3 fs-1"></i>
        <div class="fs-3">Change <b class="text-color1">Password</b></div>
       Create a new password to keep your account secure
    </div>
</div>
@*Heading End*@
<div class="row py-2">
    <div class="col-sm-4 mx-auto">
        <div class="shadow-lg mx-auto rounded-4 px-5 py-3">
            <form>
                <span class="text-dark fw-bold"> Current Password</span>
                <div class="form-floating mb-3 mt-1">
                    <input type="password" class="form-control" id="password" name="CPassword" placeholder="Enter Your Current Password">
                    <label for="fullname">Enter Your Current Password</label>
                </div>
                <span class="text-dark fw-bold"> New Password</span>
                <div class="form-floating mb-3 mt-1">
                    <input type="password" class="form-control" id="password" name="NPassword" placeholder="Enter Your New Password">
                    <label for="fullname">Enter Your New Password</label>
                </div>
                <span class="text-dark fw-bold"> Confirm NewPassword</span>
                <div class="form-floating mb-3 mt-1">
                    <input type="password" class="form-control" id="password" name="CNPassword" placeholder="Enter Your Confirm New Password">
                    <label for="fullname">Enter Your Confirm New Password</label>
                </div>
                <button type="submit" class="btn bg-color1 text-light" style="width:100%;">Update Password</button>
            </form>
        </div>
    </div>
</div>

