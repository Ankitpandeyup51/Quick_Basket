                <div class="row shadow-lg mx-auto p-3 shop rounded-2">
                    <div class="col-7">
                        <b>Explore different Brand grocery</b><br />
                        <span>Up to 90% off</span><br />
                        <a href="#">Shop More<i class="fa-solid fa-arrow-right"></i></a><br />
                    </div>
                    <div class="col-5">
                        <img src="~/Content/images/product/img-5.jpg" class="w-100" />
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="row shadow-lg mx-auto p-3 shop rounded-2">
                    <div class="col-7">
                        <b>Explore different Brand grocery</b><br />
                        <span>Up to 90% off</span><br />
                        <a href="#">Shop More<i class="fa-solid fa-arrow-right"></i></a><br />
                    </div>
                    <div class="col-5">
                        <img src="~/Content/images/product/img-6.jpg" class="w-100" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*Shop Section End*@
@*Features Product Start*@
@*Features Product End*@
